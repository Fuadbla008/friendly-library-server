# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3000

# MongoDB — prefer one connection string. MONGODB_USER/MONGODB_PASS is a
# backwards-compatible fallback for the original Atlas cluster.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=friendly_library
BOOKS_COLLECTION=book_data
BORROWS_COLLECTION=borrows
# MONGODB_USER=
# MONGODB_PASS=
# MONGODB_HOSTS=
# MONGODB_OPTIONS=

# BetterAuth JWT verification. BETTER_AUTH_URL is the CLIENT origin, not the
# API origin. The JWKS URL defaults to <BETTER_AUTH_URL>/api/auth/jwks.
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# JWT_ISSUER=http://localhost:3000
# JWT_AUDIENCE=http://localhost:3000

# HS256 fallback for scripts/make-token.mjs and local API testing only.
JWT_SECRET=replace-with-a-long-random-string

LOAN_DAYS=14
